# Local development. No account or token required for this file database.
TURSO_DATABASE_URL=file:./tempo.local.db
TURSO_AUTH_TOKEN=

# On Vercel, use the URL and token from your Turso libSQL database instead.
# TURSO_DATABASE_URL=libsql://your-database-your-account.turso.io
# TURSO_AUTH_TOKEN=your-database-token
